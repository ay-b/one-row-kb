<?xml version="1.0" encoding="utf-8"?>
<!-- Languages the system may ask for. The checker itself answers for all enabled keyboard languages. -->
<spell-checker xmlns:android="http://schemas.android.com/apk/res/android"
    android:label="@string/app_name"
    android:settingsActivity="com.example.onerow.MainActivity">
    <subtype android:label="English" android:subtypeLocale="en"/>
    <subtype android:label="Français" android:subtypeLocale="fr"/>
    <subtype android:label="Deutsch" android:subtypeLocale="de"/>
    <subtype android:label="Español" android:subtypeLocale="es"/>
    <subtype android:label="Português" android:subtypeLocale="pt"/>
    <subtype android:label="Русский" android:subtypeLocale="ru"/>
    <subtype android:label="Українська" android:subtypeLocale="uk"/>
</spell-checker>
